---
import LogoWall from "../components/logoWall.astro";
import SkillsList from "../React/SkillsList.tsx";
import HeroSignalField from "../components/effects/HeroSignalField.astro";
import ProfileOrbit from "../components/ProfileOrbit.astro";
---

<section class="hero-surface text-[var(--white)] relative min-h-[100dvh] flex flex-col overflow-hidden" id="home">
  <HeroSignalField />
  <p class="hero-watermark pointer-events-none absolute top-6 right-[var(--grid-gutter)] z-[1] select-none hidden md:block" aria-hidden="true">
    12.9714°S · 38.5014°W
  </p>

  <div class="max-w-5xl mx-auto w-full relative z-10 pt-24 md:pt-32 pb-10 flex-1 flex flex-col justify-center">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7 min-w-0" data-hero-left>
        <p class="hero-item hero-delay-1 mb-6 inline-flex w-fit items-center gap-3 type-label !text-[var(--accent-primary)]">
          <span class="hero-avail-dot" aria-hidden="true"></span>
          Open to international remote · UTC−3
        </p>

        <p class="hero-item hero-delay-2 type-label mb-5">Software developer · GIS applications · Brasil</p>

        <h1 class="hero-item hero-delay-3 mb-6 max-w-xl">
          <span class="sr-only">Junior Reis, software developer specializing in GIS applications</span>
          <span class="block text-[1.65rem] sm:text-[2.15rem] md:text-[2.55rem] font-semibold leading-[1.22] tracking-tight" style="font-family: var(--font-display)">
            I’m Junior Reis, a software developer
            <span class="text-[var(--text-secondary)] font-medium"> specializing in </span>
            <span class="text-[var(--accent-gold)]">GIS applications</span>.
            <span class="text-[var(--text-secondary)] font-medium"> I put maps, water data, and infrastructure into production software — from Salvador, Brazil, for teams anywhere on Earth.</span>
          </span>
        </h1>

        <p class="hero-item hero-delay-4 type-lead max-w-xl mb-8">
          Currently GIS Developer at the Secretariat of Water Infrastructure and Sanitation (SIHS),
          Government of Bahia. On ArcGIS Enterprise I ship web maps, Dashboards, Experience Builder
          apps, and the full stack around them — spatial data, APIs, and interfaces non-technical
          teams can actually run.
        </p>

        <div class="hero-item hero-delay-5 flex flex-wrap gap-3 pt-2">
          <a target="_blank" href="https://github.com/JuniorReisx" aria-label="GitHub" class="social-btn" data-magnetic data-cursor="external" data-cursor-arrow="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"/>
            </svg>
          </a>
          <a target="_blank" href="https://www.linkedin.com/in/gil-maik-junior/" aria-label="LinkedIn" class="social-btn" data-magnetic data-cursor="external" data-cursor-arrow="true">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path d="M18.3362 18.339H15.6707V14.1622C15.6707 13.1662 15.6505 11.8845 14.2817 11.8845C12.892 11.8845 12.6797 12.9683 12.6797 14.0887V18.339H10.0142V9.75H12.5747V10.9207H12.6092C12.967 10.2457 13.837 9.53325 15.1367 9.53325C17.8375 9.53325 18.337 11.3108 18.337 13.6245V18.339H18.3362ZM7.00373 8.57475C6.14573 8.57475 5.45648 7.88025 5.45648 7.026C5.45648 6.1725 6.14648 5.47875 7.00373 5.47875C7.85873 5.47875 8.55173 6.1725 8.55173 7.026C8.55173 7.88025 7.85798 8.57475 7.00373 8.57475ZM8.34023 18.339H5.66723V9.75H8.34023V18.339ZM19.6697 3H4.32923C3.59498 3 3.00098 3.5805 3.00098 4.29675V19.7033C3.00098 20.4202 3.59498 21 4.32923 21H19.6675C20.401 21 21.001 20.4202 21.001 19.7033V4.29675C21.001 3.5805 20.401 3 19.6675 3H19.6697Z"/>
            </svg>
          </a>
          <a href="mailto:gilmaikjunior2@gmail.com" aria-label="Email" class="social-btn" data-magnetic data-cursor="contact">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-6">
              <path d="m18.73 5.41l-1.28 1L12 10.46L6.55 6.37l-1.28-1A2 2 0 0 0 2 7.05v11.59A1.36 1.36 0 0 0 3.36 20h3.19v-7.72L12 16.37l5.45-4.09V20h3.19A1.36 1.36 0 0 0 22 18.64V7.05a2 2 0 0 0-3.27-1.64"/>
            </svg>
          </a>
        </div>
      </div>

      <div class="lg:col-span-5 min-w-0 hero-item hero-delay-6" data-hero-right>
        <ProfileOrbit />
      </div>
    </div>

    <div class="hero-scroll-row hero-item hero-delay-7">
      <a href="#about" class="hero-scroll-cue" aria-label="Scroll to about">
        <span class="type-label">Continue</span>
        <span class="hero-scroll-track">
          <span class="hero-scroll-dot"></span>
        </span>
      </a>
    </div>
  </div>
</section>

<section class="py-16 border-y border-[var(--border-subtle)]" aria-label="Stack and capabilities">
  <div class="max-w-5xl mx-auto">
    <p class="type-label mb-6">toolchain</p>
    <LogoWall />
    <div class="mt-14">
      <SkillsList client:load />
    </div>
  </div>
</section>

<style>
  .hero-item {
    opacity: 0;
    transform: translateY(20px);
    animation: heroFadeUp 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .hero-delay-1 { animation-delay: 0.06s; }
  .hero-delay-2 { animation-delay: 0.14s; }
  .hero-delay-3 { animation-delay: 0.22s; }
  .hero-delay-4 { animation-delay: 0.32s; }
  .hero-delay-5 { animation-delay: 0.42s; }
  .hero-delay-6 { animation-delay: 0.52s; }
  .hero-delay-7 { animation-delay: 0.64s; }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .social-btn {
    color: var(--text-secondary);
    transition: color 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    border: 1px solid var(--border-subtle);
    padding: 0.7rem;
    background: color-mix(in srgb, var(--bg-secondary) 80%, transparent);
  }

  .social-btn:hover {
    color: var(--text-primary);
    border-color: color-mix(in srgb, var(--accent-primary) 45%, var(--border-subtle));
  }
</style>
