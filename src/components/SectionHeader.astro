---
interface Props {
  index?: string;
  eyebrow: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { index, eyebrow, title, description, align = "left" } = Astro.props;
const alignClass = align === "center" ? "text-center mx-auto" : "text-left";
---

<div class={`reveal-on-scroll mb-12 md:mb-16 max-w-2xl ${alignClass}`}>
  <p class={`section-label mb-4 ${align === "center" ? "justify-center" : ""}`}>
    {index && <span class="section-index">{index}</span>}
    {eyebrow}
  </p>
  <h2 class="section-title">{title}</h2>
  {description && (
    <p class="mt-5 type-lead">{description}</p>
  )}
</div>

<div class={`reveal-on-scroll mb-12 md:mb-16 max-w-2xl ${alignClass}`}>
  <p class={`section-label mb-4 ${align === "center" ? "justify-center" : ""}`}>{eyebrow}</p>
  <h2 class="section-title">{title}</h2>
  {description && (
    <p class="mt-5 type-lead">{description}</p>
  )}
</div>
