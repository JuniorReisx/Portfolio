---
---

<div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none" aria-hidden="true">
  <div class="aurora-blob aurora-1"></div>
  <div class="aurora-blob aurora-2"></div>
  <div class="aurora-blob aurora-3"></div>
  <div class="graticule"></div>
  <div class="noise-layer"></div>
</div>

<style>
  .aurora-blob {
    position: absolute;
    filter: blur(64px);
    opacity: 0.7;
    animation: aurora 28s ease-in-out infinite;
  }

  .aurora-1 {
    width: 55vw;
    height: 50vh;
    top: -18%;
    left: -12%;
    background: radial-gradient(ellipse, rgba(62, 207, 200, 0.16), transparent 70%);
  }

  .aurora-2 {
    width: 45vw;
    height: 45vh;
    top: 8%;
    right: -16%;
    background: radial-gradient(ellipse, rgba(212, 162, 74, 0.12), transparent 70%);
    animation-delay: -10s;
  }

  .aurora-3 {
    width: 40vw;
    height: 40vh;
    bottom: 8%;
    left: 28%;
    background: radial-gradient(ellipse, rgba(62, 207, 200, 0.08), transparent 70%);
    animation-delay: -18s;
  }

  @keyframes aurora {
    0%,
    100% {
      transform: translate(0, 0) scale(1);
    }
    50% {
      transform: translate(3%, -2%) scale(1.06);
    }
  }

  .graticule {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(62, 207, 200, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(62, 207, 200, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 20%, black, transparent 78%);
  }

  .noise-layer {
    position: absolute;
    inset: 0;
    opacity: 0.03;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
  }

  @media (prefers-reduced-motion: reduce) {
    .aurora-blob {
      animation: none;
    }
  }
</style>
