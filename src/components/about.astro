---
import SectionHeader from "./SectionHeader.astro";

const facts = [
  { label: "Current role", value: "GIS Developer · SIHS" },
  { label: "Focus", value: "ArcGIS Enterprise · Water GIS" },
  { label: "Based in", value: "Salvador, Brazil · UTC−3" },
  { label: "Availability", value: "Remote worldwide" },
  { label: "Languages", value: "Portuguese · English" },
  { label: "Work style", value: "End-to-end ownership" },
];
---

<section id="about" class="w-full py-20 md:py-28 border-t border-[#ffffff08]" aria-label="About">
  <div class="max-w-5xl mx-auto">
    <SectionHeader
      index="01"
      eyebrow="Profile"
      title="Software that puts GIS on the ground"
      description="I build the applications behind the map: spatial data, web GIS, and operational software for water and public infrastructure in Brazil — written so teams abroad can hire me on the work, not the buzzwords."
    />

    <div class="grid lg:grid-cols-5 gap-8 lg:gap-12">
      <div class="reveal-on-scroll lg:col-span-3 space-y-5 text-[var(--white-icon)] leading-relaxed text-base md:text-lg">
        <p>
          I am a software developer who builds GIS applications. That means more than drawing maps:
          I design the databases, APIs, and interfaces that turn hydrologic and infrastructure data
          into tools government and operations teams use every day.
        </p>
        <p>
          At the <span class="text-[var(--white)]">Secretariat of Water Infrastructure and Sanitation (SIHS)</span>
          in Bahia, I work from Salvador — on the Atlantic, at 12.97°S — on ArcGIS Enterprise:
          web maps, Dashboards, Experience Builder, and GIS applications for water networks.
          The craft is geospatial. The delivery is software: TypeScript, React,
          PostgreSQL / PostGIS, and the Esri stack in production.
        </p>
        <p>
          I want <span class="text-[var(--white)]">international remote work</span> with teams that treat
          GIS as product, not a plugin. Water, environment, energy, cities — anywhere Earth data has to
          become a decision.
        </p>
      </div>

      <dl class="reveal-on-scroll lg:col-span-2 grid grid-cols-2 gap-3 content-start">
        {
          facts.map((fact) => (
            <div class="premium-surface p-4" data-spotlight>
              <dt class="text-[0.65rem] uppercase tracking-wider text-[var(--white-icon)]">{fact.label}</dt>
              <dd class="mt-1.5 text-sm font-semibold text-[var(--white)] leading-snug">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
