---
import SectionHeader from "./SectionHeader.astro";

const facts = [
  { label: "Current role", value: "Software Developer · SIHS" },
  { label: "Stack", value: "React · Node · GIS · SQL" },
  { label: "Based in", value: "Salvador, Brazil · UTC−3" },
  { label: "Availability", value: "Remote worldwide" },
  { label: "Languages", value: "Portuguese · English" },
  { label: "Work style", value: "End-to-end ownership" },
];
---

<section id="about" class="w-full py-20 md:py-28 border-t border-[#ffffff08]" aria-label="About">
  <div class="max-w-5xl mx-auto">
    <SectionHeader
      index="01"
      eyebrow="Profile"
      title="From Salvador to remote teams worldwide"
      description="I build and ship software end to end — interfaces, APIs, and data. GIS is one of my strongest stacks, not the only thing I do."
    />

    <div class="grid lg:grid-cols-5 gap-8 lg:gap-12">
      <div class="reveal-on-scroll lg:col-span-3 space-y-5 text-[var(--white-icon)] leading-relaxed text-base md:text-lg">
        <p>
          Most of my work is product engineering: schema design, auth, REST APIs, and React/TypeScript
          apps that real teams use daily. I care about shipping something maintainable — not demos that
          die after the pitch.
        </p>
        <p>
          At <span class="text-[var(--white)]">SIHS (Government of Bahia)</span> that means portals,
          booking systems, and water-network tools. When the domain is spatial I use ArcGIS, PostGIS,
          and MapLibre; when it isn’t, I still own the full stack.
        </p>
        <p>
          I’m looking for <span class="text-[var(--white)]">international remote roles</span> —
          full-stack, backend, or product engineering — including teams that need strong GIS skills
          in the mix.
        </p>
      </div>

      <dl class="reveal-on-scroll lg:col-span-2 grid grid-cols-2 gap-3 content-start">
        {
          facts.map((fact) => (
            <div class="premium-surface p-4" data-spotlight>
              <dt class="text-[0.65rem] uppercase tracking-wider text-[var(--white-icon)]">{fact.label}</dt>
              <dd class="mt-1.5 text-sm font-semibold text-[var(--white)] leading-snug">{fact.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>
