---
import { Image } from "astro:assets";
import SectionHeader from "./SectionHeader.astro";
import sihs from "../../public/sihs.png";
import paraguacu from "../../public/paraguacu.jpg";
import type { ImageMetadata } from "astro";

interface Experience {
  company: string;
  companyShort: string;
  role: string;
  period: string;
  type: string;
  focus?: string;
  description: string;
  highlights: { k: string; v: string }[];
  technologies: string[];
  logo: ImageMetadata | string;
  isImage: boolean;
}

const experiences: Experience[] = [
  {
    company: "Secretariat of Water Infrastructure and Sanitation · Government of Bahia",
    companyShort: "SIHS · Bahia, Brazil",
    role: "Software Engineer, GIS",
    period: "2025 — Present",
    type: "Full-time",
    focus: "Primary focus: ArcGIS Enterprise at SIHS — web maps, dashboards, Experience Builder, and GIS applications in production.",
    description:
      "I build the software that puts water infrastructure on a map and into daily operations. At SIHS I work on ArcGIS Enterprise: I publish web maps, build ArcGIS Dashboards, and ship Experience Builder applications so water and sanitation teams can run the network from the browser. GIS is the core. The rest of the job is engineering — APIs, auth, and internal products used by people who never open a GIS desktop.",
    highlights: [
      {
        k: "ArcGIS",
        v: "ArcGIS Enterprise as the production GIS stack — web maps, Dashboards, Experience Builder, and GIS applications for hydraulic planning and water/sanitation networks.",
      },
      {
        k: "Apps",
        v: "Operational apps on that stack: interactive web maps, monitoring dashboards, and Experience Builder experiences for field and office staff.",
      },
      {
        k: "Data",
        v: "PostGIS / PostgreSQL as the source of truth; REST APIs so ArcGIS apps, maps, and ops tools consume the same spatial + operational data.",
      },
      {
        k: "Software",
        v: "Internal products beyond the map: systems portal and meeting-room booking with LDAP on government infrastructure.",
      },
    ],
    technologies: [
      "ArcGIS Enterprise",
      "ArcGIS Dashboards",
      "Experience Builder",
      "Web Maps",
      "MapLibre GL",
      "PostGIS",
      "QGIS",
      "TypeScript",
      "React",
      "PostgreSQL",
      "LDAP",
    ],
    logo: sihs as ImageMetadata,
    isImage: true,
  },
  {
    company: "Paraguaçu Engenharia",
    companyShort: "Paraguaçu Engenharia",
    role: "Technical Support Analyst",
    period: "2024 — 2025",
    type: "Full-time",
    description:
      "Corporate infrastructure: keep servers, networks, and people unblocked so engineering work can ship.",
    highlights: [
      { k: "Infra", v: "Windows Server and corporate network monitoring in a live operations environment." },
      { k: "Ops", v: "L1/L2 tickets and SLAs — incident triage, not just hardware swaps." },
      { k: "IAM", v: "Active Directory, workstations, and the access layer the rest of the company sits on." },
    ],
    technologies: [
      "Windows Server",
      "Active Directory",
      "Networking",
      "Helpdesk",
      "Monitoring",
      "Troubleshooting",
    ],
    logo: paraguacu as ImageMetadata,
    isImage: true,
  },
  {
    company: "Independent projects",
    companyShort: "Independent",
    role: "Software Developer",
    period: "2022 — Present",
    type: "Project-based",
    description:
      "End-to-end web products for clients — prototype to production, with the same delivery bar as the GIS work: ship it, don’t just demo it.",
    highlights: [
      { k: "Web", v: "Landing pages and dashboards in React / TypeScript, designed to convert and to last." },
      { k: "Integrate", v: "Payments, APIs, and relational databases wired into real user flows." },
      { k: "Ship", v: "CI-friendly deploys on Vercel — lean pipelines, SEO, maintainable code." },
    ],
    technologies: [
      "React",
      "TypeScript",
      "Node.js",
      "PostgreSQL",
      "Vite",
      "Figma",
      "Vercel",
      "SEO",
    ],
    logo: "⚡",
    isImage: false,
  },
];
---

<section id="experience" class="w-full py-20 md:py-28 relative overflow-hidden border-t border-[#ffffff08]">
  <div class="max-w-5xl mx-auto">
    <SectionHeader
      index="03"
      eyebrow="Experience"
      title="GIS is the focus. Software is how it ships."
      description="ArcGIS Enterprise at SIHS in Bahia — web maps, dashboards, Experience Builder — and the engineering around it: APIs, auth, and products people use without speaking GIS."
      align="center"
    />

    <div class="experience-list space-y-6 md:space-y-8">
      {
        experiences.map((exp, index) => (
          <article
            class="reveal-on-scroll exp-card group" data-spotlight
            style={`transition-delay: ${index * 0.08}s`}
          >
            <div class="exp-card-glow" aria-hidden="true"></div>

            <div class="exp-card-inner">
              <header class="exp-card-header">
                <div class="exp-logo-wrap">
                  {exp.isImage ? (
                    <Image
                      src={exp.logo as ImageMetadata}
                      alt={exp.company}
                      class="exp-logo-img"
                      width={80}
                      height={80}
                    />
                  ) : (
                    <span class="exp-logo-emoji">{exp.logo}</span>
                  )}
                </div>

                <div class="exp-header-text">
                  <div class="exp-meta-row">
                    <span class="exp-role-badge">{exp.role}</span>
                    <span class="exp-type-chip">{exp.type}</span>
                  </div>
                  <h3 class="exp-company">{exp.companyShort}</h3>
                  <p class="exp-company-full">{exp.company}</p>
                  {exp.focus && <p class="exp-focus">{exp.focus}</p>}
                  <time class="exp-period" datetime={exp.period.replace(" — ", "/")}>
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="exp-period-icon" aria-hidden="true">
                      <path d="M12 22C6.47715 22 2 17.5228 2 12C2 6.47715 6.47715 2 12 2C17.5228 2 22 6.47715 22 12C22 17.5228 17.5228 22 12 22ZM12 20C16.4183 20 20 16.4183 20 12C20 7.58172 16.4183 4 12 4C7.58172 4 4 7.58172 4 12C4 16.4183 7.58172 20 12 20ZM13 12H17V14H11V7H13V12Z"/>
                    </svg>
                    {exp.period}
                  </time>
                </div>
              </header>

              <p class="exp-description">{exp.description}</p>

              <ul class="exp-highlights">
                {exp.highlights.map((item) => (
                  <li>
                    <span class="exp-highlight-k">{item.k}</span>
                    <span>{item.v}</span>
                  </li>
                ))}
              </ul>

              <div class="exp-tech">
                {exp.technologies.map((tech) => (
                  <span class="exp-tech-tag">{tech}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .experience-list {
    position: relative;
  }

  .exp-card {
    position: relative;
    border-radius: 0;
  }

  .exp-card-glow {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    background: linear-gradient(
      135deg,
      color-mix(in srgb, var(--sec) 40%, transparent),
      transparent 45%,
      color-mix(in srgb, var(--sec) 15%, transparent)
    );
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .exp-card:hover .exp-card-glow,
  .exp-card:focus-within .exp-card-glow {
    opacity: 1;
  }

  .exp-card-inner {
    position: relative;
    padding: 1.5rem;
    border-radius: 0;
    background: linear-gradient(145deg, #ffffff0c 0%, #ffffff03 55%, #ffffff01 100%);
    border: 1px solid #ffffff12;
    backdrop-filter: blur(12px);
    transition:
      border-color 0.35s ease,
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.35s ease;
  }

  @media (min-width: 768px) {
    .exp-card-inner {
      padding: 2rem 2.25rem;
    }
  }

  .exp-card:hover .exp-card-inner {
    border-color: color-mix(in srgb, var(--sec) 35%, transparent);
    transform: translateY(-4px);
    box-shadow:
      0 20px 50px rgba(0, 0, 0, 0.35),
      0 0 0 1px color-mix(in srgb, var(--sec) 12%, transparent);
  }

  .exp-card-header {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }

  .exp-logo-wrap {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid #ffffff18;
    background: linear-gradient(145deg, #ffffff12, #ffffff04);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
    transition: transform 0.35s ease;
  }

  .exp-card:hover .exp-logo-wrap {
    transform: scale(1.05);
  }

  .exp-logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .exp-logo-emoji {
    font-size: 1.75rem;
    line-height: 1;
  }

  .exp-header-text {
    flex: 1;
    min-width: 0;
  }

  .exp-meta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  .exp-role-badge {
    display: inline-flex;
    padding: 0.3rem 0.75rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--background);
    background: linear-gradient(135deg, var(--sec), #818cf8);
    border-radius: 0;
    box-shadow: 0 2px 12px var(--glow);
  }

  .exp-type-chip {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--white-icon);
    padding: 0.25rem 0.6rem;
    border-radius: 0;
    border: 1px solid #ffffff14;
    background: #ffffff06;
  }

  .exp-company {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--white);
    line-height: 1.2;
    margin-bottom: 0.2rem;
  }

  @media (min-width: 768px) {
    .exp-company {
      font-size: 1.5rem;
    }
  }

  .exp-company-full {
    font-size: 0.8rem;
    color: var(--white-icon);
    line-height: 1.4;
    margin-bottom: 0.35rem;
  }

  .exp-focus {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.02em;
    color: var(--accent-gold);
    line-height: 1.5;
    margin-bottom: 0.5rem;
    max-width: 42rem;
  }

  .exp-period {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--sec);
  }

  .exp-period-icon {
    width: 1rem;
    height: 1rem;
    opacity: 0.9;
  }

  .exp-description {
    color: var(--white-icon);
    line-height: 1.7;
    font-size: 0.95rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .exp-description {
      font-size: 1rem;
    }
  }

  .exp-highlights {
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
    border: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--bg-void) 55%, transparent);
    display: flex;
    flex-direction: column;
  }

  .exp-highlights li {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    font-size: 0.875rem;
    color: var(--text-primary);
    line-height: 1.55;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .exp-highlights li:last-child {
    border-bottom: none;
  }

  .exp-highlight-k {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-primary);
    padding-top: 0.15rem;
  }

  @media (max-width: 639px) {
    .exp-highlights li {
      grid-template-columns: 1fr;
      gap: 0.3rem;
    }
  }

  .exp-tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .exp-tech-tag {
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.35rem 0.75rem;
    color: var(--white-icon);
    background: #ffffff08;
    border: 1px solid #ffffff10;
    border-radius: 0;
    transition:
      color 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .exp-card:hover .exp-tech-tag {
    border-color: color-mix(in srgb, var(--sec) 25%, transparent);
  }

  .exp-tech-tag:hover {
    color: var(--white);
    background: color-mix(in srgb, var(--sec) 12%, transparent);
    border-color: color-mix(in srgb, var(--sec) 35%, transparent);
  }
</style>
