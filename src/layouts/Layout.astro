---
import ParticleField from "@/components/effects/ParticleField.astro";
import CustomCursor from "@/components/effects/CustomCursor.astro";

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Junior Reis — software developer from Salvador, Brazil. Full-stack web apps, APIs, and GIS systems. Open to international remote roles.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="author" content="Junior Reis" />
    <meta name="theme-color" content="#0b0714" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&family=IBM+Plex+Mono:wght@400;500;600&family=Syne:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Junior Reis Portfolio" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body class="bg-[var(--background)] text-[var(--white)] antialiased">
    <a href="#home" class="skip-link">Skip to content</a>
    <div id="scroll-progress" aria-hidden="true"></div>
    <ParticleField />
    <CustomCursor />
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg-void: #0b0714;
    --bg-primary: #100c1a;
    --bg-secondary: #181225;
    --bg-elevated: #221a34;
    --glass: rgba(79, 70, 229, 0.04);
    --accent-primary: #4f46e5;
    --accent-gold: #818cf8;
    --accent-rgb: 79, 70, 229;
    --accent-glow: rgba(var(--accent-rgb), 0.16);
    --text-primary: #eeeaf6;
    --text-secondary: #a89bb8;
    --text-muted: #7a708c;
    --border-subtle: #2c2340;
    --grid-max: 75rem;
    --grid-gutter: 1.25rem;
    --font-display: "Syne", "DM Sans", sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, monospace;

    --background: var(--bg-primary);
    --background-elevated: var(--bg-elevated);
    --sec: var(--accent-primary);
    --sec-dim: #3730a3;
    --white: var(--text-primary);
    --white-icon: var(--text-secondary);
    --white-icon-tr: #ffffff12;
    --component-bg: #181225ee;
    --container: var(--bg-secondary);
    --line: var(--border-subtle);
    --glow: rgba(79, 70, 229, 0.28);
  }

  @media (min-width: 640px) {
    :root {
      --grid-gutter: 2rem;
    }
  }

  @media (min-width: 1024px) {
    :root {
      --grid-gutter: 3rem;
    }
  }

  * {
    font-family: "DM Sans", -apple-system, system-ui, sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  h1,
  h2,
  h3,
  h4,
  .font-display {
    font-family: var(--font-display);
    letter-spacing: -0.04em;
  }

  *::selection {
    background: rgba(79, 70, 229, 0.28);
    color: #fff;
  }

  html {
    scroll-behavior: smooth;
    overflow-x: clip;
  }

  body {
    position: relative;
    min-height: 100vh;
    overflow-x: clip;
    letter-spacing: -0.014em;
    background:
      radial-gradient(ellipse 60% 35% at 50% -15%, rgba(79, 70, 229, 0.05), transparent 60%),
      var(--bg-primary);
  }

  section .max-w-5xl,
  footer .max-w-5xl {
    padding-inline: var(--grid-gutter);
  }

  .skip-link {
    position: absolute;
    top: -100px;
    left: 1rem;
    z-index: 200;
    padding: 0.75rem 1.25rem;
    background: var(--accent-primary);
    color: var(--bg-void);
    font-weight: 600;
    text-decoration: none;
    transition: top 0.2s;
  }

  .skip-link:focus {
    top: 1rem;
  }

  #scroll-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: linear-gradient(90deg, var(--sec-dim), var(--accent-primary), #818cf8);
    z-index: 9999;
    box-shadow: 0 0 12px var(--glow);
  }

  .type-label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .type-display-xl {
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 8vw + 0.5rem, 6.4rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.055em;
    color: var(--text-primary);
  }

  .type-heading {
    font-family: var(--font-display);
    font-size: clamp(1.375rem, 1.5vw + 0.5rem, 2rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--text-secondary);
  }

  .type-lead {
    font-size: clamp(1.0625rem, 1vw + 0.5rem, 1.25rem);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .section-label {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.32em;
    color: color-mix(in srgb, var(--accent-primary) 75%, transparent);
  }

  .section-index {
    font-family: var(--font-mono);
    color: var(--accent-gold);
    letter-spacing: 0.18em;
    margin-right: 0.35rem;
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 3.5vw + 0.5rem, 3.5rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.04em;
    color: var(--text-primary);
  }

  .shiny-sec {
    color: var(--accent-primary);
  }

  .reveal-on-scroll {
    opacity: 0;
    transform: translateY(32px);
    filter: blur(8px);
    transition:
      opacity 0.8s cubic-bezier(0.33, 1, 0.68, 1),
      transform 0.8s cubic-bezier(0.33, 1, 0.68, 1),
      filter 0.8s cubic-bezier(0.33, 1, 0.68, 1);
  }

  .reveal-on-scroll.is-visible {
    opacity: 1;
    transform: translateY(0);
    filter: blur(0);
  }

  .glass-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-subtle);
  }

  .premium-surface {
    border: 1px solid rgba(60, 46, 88, 0.9);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.022), transparent 34%),
      #0c0914;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.04),
      0 1px 0 rgba(79, 70, 229, 0.04);
    transition:
      border-color 0.4s ease,
      box-shadow 0.4s ease,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .premium-surface:hover {
    border-color: rgba(79, 70, 229, 0.28);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.055),
      0 24px 48px rgba(0, 0, 0, 0.28),
      0 0 32px rgba(79, 70, 229, 0.06);
    transform: translateY(-2px);
  }

  .btn-primary,
  .btn-secondary,
  .btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    height: 3rem;
    padding: 0 1.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    border: none;
  }

  .btn-primary {
    color: #0a0a0f;
    background: var(--accent-primary);
    box-shadow: none;
    transition:
      filter 0.25s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.25s ease;
  }

  .btn-primary:hover {
    filter: brightness(1.08);
    box-shadow: 0 0 40px var(--accent-glow);
    transform: translateY(-1px);
  }

  .btn-secondary {
    color: var(--text-primary);
    background: transparent;
    border: 1px solid var(--border-subtle);
    transition:
      background 0.25s ease,
      border-color 0.25s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.03);
    border-color: rgba(79, 70, 229, 0.45);
    transform: translateY(-1px);
  }

  .btn-ghost {
    color: var(--text-muted);
    background: transparent;
    border: 1px solid transparent;
  }

  .btn-ghost:hover {
    color: var(--text-primary);
    border-color: var(--border-subtle);
  }

  .hero-surface {
    background:
      radial-gradient(ellipse 55% 45% at 80% 15%, rgba(255, 255, 255, 0.05), transparent 55%),
      radial-gradient(ellipse 40% 35% at 10% 90%, rgba(79, 70, 229, 0.04), transparent 50%),
      var(--bg-void);
  }

  .hero-name-stack {
    width: 100%;
  }

  .hero-name-line--second {
    margin-left: clamp(0.5rem, 4vw, 3rem);
  }

  .hero-name-accent {
    color: var(--accent-gold);
  }

  .hero-watermark {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--text-muted);
    opacity: 0.4;
  }

  .hero-avail-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-primary);
    box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.55);
    animation: hero-avail-pulse 2.2s ease-out infinite;
  }

  @keyframes hero-avail-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.45);
    }
    70% {
      box-shadow: 0 0 0 10px rgba(79, 70, 229, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(79, 70, 229, 0);
    }
  }

  .hero-scroll-row {
    display: flex;
    justify-content: center;
    margin-top: 3rem;
    padding-bottom: 1.5rem;
  }

  .hero-scroll-cue {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-scroll-track {
    position: relative;
    display: block;
    width: 1px;
    height: 2.25rem;
    overflow: hidden;
    background: linear-gradient(180deg, transparent, color-mix(in srgb, var(--accent-primary) 45%, transparent) 40%, transparent);
  }

  .hero-scroll-dot {
    position: absolute;
    left: 50%;
    top: 0;
    width: 5px;
    height: 5px;
    margin-left: -2.5px;
    border-radius: 999px;
    background: var(--accent-primary);
    box-shadow: 0 0 12px rgba(79, 70, 229, 0.55);
    animation: hero-scroll-dot 2.1s ease-in-out infinite;
  }

  @keyframes hero-scroll-dot {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    75% {
      transform: translateY(2rem);
      opacity: 1;
    }
    100% {
      transform: translateY(2.25rem);
      opacity: 0;
    }
  }

  .hero-visual-frame {
    border: 1px solid color-mix(in srgb, var(--border-subtle) 70%, transparent);
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.03),
      0 40px 80px rgba(0, 0, 0, 0.35);
  }

  .hero-visual-grid {
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, black 20%, transparent 72%);
  }

  .hero-visual-hud,
  .hero-stack-feed,
  .hero-visual-metric {
    border: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--bg-secondary) 85%, transparent);
    backdrop-filter: blur(10px);
  }

  .hero-visual-scene-wrap {
    filter: drop-shadow(0 24px 48px rgba(79, 70, 229, 0.12));
  }

  .hero-stack-feed-track {
    width: max-content;
    animation: hero-stack-feed 28s linear infinite;
  }

  @keyframes hero-stack-feed {
    to {
      transform: translateX(-50%);
    }
  }

  .hero-visual-metric {
    position: relative;
    overflow: hidden;
  }

  .hero-visual-metric::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, transparent, rgba(79, 70, 229, 0.06), transparent);
    transform: translateX(-120%);
    animation: hero-metric-shine 4.5s ease-in-out infinite;
  }

  @keyframes hero-metric-shine {
    70%,
    100% {
      transform: translateX(-120%);
    }
    85% {
      transform: translateX(120%);
    }
  }

  [data-spotlight] {
    position: relative;
    --x: 50%;
    --y: 50%;
  }

  [data-spotlight]::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(
      420px circle at var(--x) var(--y),
      rgba(79, 70, 229, 0.08),
      transparent 42%
    );
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: 1;
  }

  [data-spotlight]:hover::after {
    opacity: 1;
  }

  .project-card-glow {
    position: relative;
  }

  .project-card-glow::before {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, rgba(79, 70, 229, 0.28), transparent 40%, rgba(79, 70, 229, 0.12));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
  }

  .project-card-glow:hover::before {
    opacity: 1;
  }

  .custom-cursor-active,
  .custom-cursor-active a,
  .custom-cursor-active button {
    cursor: none;
  }

  .pc {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 10001;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .pc.pc--visible {
    opacity: 1;
  }

  .pc__dot,
  .pc__ring,
  .pc__glow,
  .pc__label {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    will-change: transform;
  }

  .pc__dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #f8fafc;
    box-shadow: 0 0 8px rgba(79, 70, 229, 0.55);
    z-index: 10004;
  }

  .pc__ring {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(148, 163, 184, 0.45);
    z-index: 10003;
  }

  .pc__glow {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(79, 70, 229, 0.22) 0%, transparent 70%);
    z-index: 10002;
    opacity: 0.22;
  }

  .pc__label {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #e2e8f0;
    background: rgba(10, 15, 26, 0.88);
    border: 1px solid rgba(79, 70, 229, 0.25);
    z-index: 10005;
    white-space: nowrap;
  }

  .pc__label-arrow {
    color: var(--accent-primary);
  }

  .pc[data-mode="link"] .pc__ring,
  .pc[data-mode="button"] .pc__ring,
  .pc[data-mode="contact"] .pc__ring {
    border-color: rgba(79, 70, 229, 0.55);
    background: rgba(79, 70, 229, 0.08);
    box-shadow: 0 0 20px rgba(79, 70, 229, 0.2);
  }

  @media (pointer: coarse) {
    .pc {
      display: none !important;
    }

    .custom-cursor-active,
    .custom-cursor-active a,
    .custom-cursor-active button {
      cursor: auto;
    }
  }

  ::-webkit-scrollbar {
    width: 10px;
  }

  ::-webkit-scrollbar-track {
    background: var(--bg-secondary);
  }

  ::-webkit-scrollbar-thumb {
    background: color-mix(in srgb, var(--accent-primary) 30%, var(--border-subtle));
    border-radius: 10px;
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: color-mix(in srgb, var(--accent-primary) 30%, var(--border-subtle)) var(--bg-secondary);
  }

  .stack-console {
    margin-top: 0.5rem;
  }

  .stack-console-head {
    display: grid;
    gap: 0.75rem 2rem;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .stack-console-head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  .stack-console-title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3vw, 2.35rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    color: var(--text-primary);
    margin-top: 0.35rem;
  }

  .stack-console-lead {
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--text-secondary);
    max-width: 28rem;
  }

  .stack-console-grid {
    display: grid;
    gap: 0.75rem;
    border: 1px solid var(--border-subtle);
    background: color-mix(in srgb, var(--bg-void) 70%, transparent);
  }

  @media (min-width: 900px) {
    .stack-console-grid {
      grid-template-columns: minmax(16rem, 0.42fr) 1fr;
    }
  }

  .stack-modules {
    list-style: none;
    margin: 0;
    padding: 0.35rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  @media (min-width: 900px) {
    .stack-modules {
      border-bottom: none;
      border-right: 1px solid var(--border-subtle);
    }
  }

  .stack-module {
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 0.8rem;
    text-align: left;
    background: transparent;
    border: 1px solid transparent;
    color: var(--text-secondary);
    cursor: pointer;
    font: inherit;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .stack-module:hover {
    background: rgba(79, 70, 229, 0.04);
    color: var(--text-primary);
  }

  .stack-module.is-on {
    background: rgba(79, 70, 229, 0.08);
    border-color: color-mix(in srgb, var(--accent-primary) 35%, transparent);
    color: var(--text-primary);
  }

  .stack-module-code {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.12em;
    color: var(--accent-gold);
  }

  .stack-module-name {
    font-family: var(--font-display);
    font-size: 0.92rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .stack-module-status {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stack-module-status.core,
  .stack-module-status.online {
    color: var(--accent-primary);
  }

  .stack-module.is-on .stack-module-status {
    text-shadow: 0 0 10px rgba(79, 70, 229, 0.45);
  }

  .stack-term {
    min-width: 0;
    display: flex;
    flex-direction: column;
    background:
      linear-gradient(180deg, rgba(79, 70, 229, 0.03), transparent 28%),
      #051015;
  }

  .stack-term-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .stack-term-dots {
    display: flex;
    gap: 0.3rem;
  }

  .stack-term-dots i {
    width: 0.45rem;
    height: 0.45rem;
    display: block;
    background: #3a3048;
  }

  .stack-term-dots i:first-child {
    background: #4f46e5;
  }

  .stack-term-path {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .stack-term-live {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-primary);
  }

  .stack-term-body {
    margin: 0;
    padding: 1.1rem 1.15rem 0.5rem;
    overflow-x: auto;
    font-family: var(--font-mono) !important;
    font-size: 0.75rem;
    line-height: 1.7;
    color: #c8bdd9;
    white-space: pre-wrap;
  }

  .stack-term-body * {
    font-family: var(--font-mono) !important;
  }

  .stack-term-body .cmt {
    color: #7a708c;
  }

  .stack-term-body .cmd {
    color: var(--accent-primary);
  }

  .stack-term-body .cursor {
    color: var(--accent-gold);
    animation: term-blink 1.1s steps(1) infinite;
  }

  @keyframes term-blink {
    50% {
      opacity: 0;
    }
  }

  .stack-term-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.85rem 1.15rem 1.15rem;
  }

  .stack-chip {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    padding: 0.28rem 0.5rem;
    color: var(--text-primary);
    border: 1px solid var(--border-subtle);
    background: rgba(79, 70, 229, 0.05);
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }

    .reveal-on-scroll {
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
    }

    .hero-avail-dot,
    .hero-scroll-dot,
    .hero-stack-feed-track,
    .hero-visual-metric::before,
    .hero-item {
      animation: none !important;
    }

    .stack-term-body .cursor {
      animation: none;
    }
  }
</style>

<script>
  const progress = document.getElementById("scroll-progress");

  function updateProgress() {
    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    progress?.style.setProperty("width", `${pct}%`);
  }

  window.addEventListener("scroll", updateProgress, { passive: true });
  updateProgress();

  const revealObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("is-visible");
        }
      });
    },
    { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
  );

  document.querySelectorAll(".reveal-on-scroll").forEach((el) => {
    revealObserver.observe(el);
  });

  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const finePointer = window.matchMedia("(pointer: fine)").matches;

  if (!reduceMotion && finePointer) {
    document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((btn) => {
      const strength = Number.parseFloat(btn.dataset.magneticStrength || "0.32") || 0.32;
      btn.addEventListener("mousemove", (e) => {
        const rect = btn.getBoundingClientRect();
        const x = e.clientX - rect.left - rect.width / 2;
        const y = e.clientY - rect.top - rect.height / 2;
        btn.style.transition = "transform 0.4s cubic-bezier(0.16, 1, 0.3, 1)";
        btn.style.transform = `translate(${x * strength}px, ${y * strength}px) scale(1.035)`;
      });
      btn.addEventListener("mouseleave", () => {
        btn.style.transition = "transform 0.65s cubic-bezier(0.34, 1.56, 0.64, 1)";
        btn.style.transform = "translate(0, 0) scale(1)";
      });
    });

    document.querySelectorAll<HTMLElement>("[data-spotlight]").forEach((card) => {
      card.addEventListener("mousemove", (e) => {
        const rect = card.getBoundingClientRect();
        card.style.setProperty("--x", `${e.clientX - rect.left}px`);
        card.style.setProperty("--y", `${e.clientY - rect.top}px`);
      });
    });
  }
</script>
